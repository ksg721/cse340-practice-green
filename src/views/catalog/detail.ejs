<%- include('../partials/header') %>
<main>
    <div class="catalog-header">
        <h1><%= course.courseCode %> - <%= course.name %></h1>

        <p class="catalog-meta">
            <%= course.courseCode %> &bull;
            <%= course.creditHours %> credit hours
        </p>

        <p class="catalog-description">
            <%= course.description %>
        </p>
    </div>

    <div class="sort-message">
        <p>Currently sorted by: <%= currentSort %></p>
    </div>

    <div class="catalog-sections">
        <div class="catalog-sections-header">
            <h2>Available Sections</h2>

            <div class="sort-options">
                <span>Sort by: </span>

                <a
                    href="/catalog/<%= course.slug %>?sort=time"
                    class="<%= currentSort === 'time' ? 'active' : '' %>">
                    Time
                </a>

                <a
                    href="/catalog/<%= course.slug %>?sort=professor"
                    class="<%= currentSort === 'professor' ? 'active' : '' %>">
                    Professor
                </a>

                <a
                    href="/catalog/<%= course.slug %>?sort=room"
                    class="<%= currentSort === 'room' ? 'active' : '' %>">
                    Room
                </a>
            </div>
        </div>

        <% if (sections.length === 0) { %>
            <p>No sections are currently available for this course.</p>
        <% } else { %>
            <div class="catalog-section-list">
                <% sections.forEach(section => { %>
                    <div class="catalog-section-card">
                        <div class="catalog-section-time">
                            <%= section.time %>
                        </div>

                        <div class="catalog-section-room">
                            Room: <%= section.room %>
                        </div>

                        <div class="catalog-section-professor">
                            Instructor:
                            <a href="/faculty/<%= section.professorSlug %>">
                                <%= section.professor %>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <div class="catalog-navigation">
        <p>
            <a href="/catalog">&larr; Back to Course Catalog</a>
        </p>
    </div>
</main>
<%- include('../partials/footer') %>
