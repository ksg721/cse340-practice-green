<%- include('../partials/header') %>
<main>
    <h1>Course Catalog</h1>
    <p>Browse our available courses and click on any course to see detailed information including available sections and instructors.</p>

    <div class="catalog-list">
        <% courses.forEach(course => { %>
            <div class="catalog-card">
                <h3>
                    <a href="/catalog/<%= course.slug %>">
                        <%= course.courseCode %> - <%= course.name %>
                    </a>
                </h3>

                <p class="catalog-course-id">
                    <%= course.courseCode %> &bull;
                    <%= course.creditHours %> credit hours
                </p>

                <p class="catalog-course-description">
                    <%= course.description %>
                </p>
            </div>
        <% }); %>
    </div>
</main>
<%- include('../partials/footer') %>
