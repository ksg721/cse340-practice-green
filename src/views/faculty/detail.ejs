<%- include('../partials/header') %>
<main>
  <div class="faculty-header">
    <h1><%= faculty.name %></h1>
    <p class="faculty-meta">
      <%= faculty.title %> &bull; <%= faculty.department %>
    </p>
  </div>

  <div class="faculty-sections">
    <div class="faculty-sections-header">
      <h2>Faculty Information</h2>
    </div>

    <div class="faculty-info-list">
      <div class="faculty-info-card">
        <div class="faculty-info-label">Office</div>
        <div class="faculty-info-value"><%= faculty.office %></div>
      </div>
      <div class="faculty-info-card">
        <div class="faculty-info-label">Phone</div>
        <div class="faculty-info-value"><%= faculty.phone %></div>
      </div>
      <div class="faculty-info-card">
        <div class="faculty-info-label">Email</div>
        <div class="faculty-info-value">
          <a href="mailto:<%= faculty.email %>"><%= faculty.email %></a>
        </div>
      </div>
      <div class="faculty-info-card">
        <div class="faculty-info-label">Department</div>
        <div class="faculty-info-value"><%= faculty.department %></div>
      </div>
      <div class="faculty-info-card">
        <div class="faculty-info-label">Title</div>
        <div class="faculty-info-value"><%= faculty.title %></div>
      </div>
    </div>
  </div>

  <div class="faculty-navigation">
    <p><a href="/faculty">&larr; Back to Faculty Directory</a></p>
  </div>
</main>
<%- include('../partials/footer') %>
