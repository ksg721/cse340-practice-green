<%- include('../partials/header') %>
<main>
    <h1>Faculty Directory</h1>
    <p>Browse our faculty members and click on a name to view contact and department information.</p>

    <div class="sections">
        <div class="sections-header">
            <h2>Faculty Members</h2>
            <div class="sort-options">
                <span>Sort by: </span>
                <a href="/faculty" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
                <a href="/faculty?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>
                <a href="/faculty?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
            </div>
        </div>

        <div class="course-list">
            <% faculty.forEach(member => { %>
                <div class="course-card">
                    <h3><a href="/faculty/<%= member.id %>"><%= member.name %></a></h3>
                    <p class="course-id"><%= member.title %></p>
                    <p class="course-description"><%= member.department %></p>
                </div>
            <% }); %>
        </div>
    </div>
</main>
<%- include('../partials/footer') %>
